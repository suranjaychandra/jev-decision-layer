{
  "name": "jev-decision-layer",
  "version": "0.0.0",
  "private": true,
  "description": "Tacet: a marketing decision layer that knows when to stay silent. Next best action and budget steering, built with Jev and jev-state, measured raw vs jev-state.",
  "license": "MIT",
  "author": "Suranjay Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suranjaychandra/jev-decision-layer.git"
  },
  "homepage": "https://github.com/suranjaychandra/jev-decision-layer#readme",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "nba": "node --env-file-if-exists=.env --import tsx src/nba/run.ts",
    "nba:bench": "node --env-file-if-exists=.env --import tsx src/nba/bench.ts",
    "budget:bench": "node --env-file-if-exists=.env --import tsx src/budget/bench.ts",
    "nba:example": "node --env-file-if-exists=.env --import tsx src/nba/example.ts",
    "dashboard:build": "node --import tsx src/dashboard/build.ts",
    "dashboard": "npm run dashboard:build && node --import tsx src/dashboard/serve.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "jev-state": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
